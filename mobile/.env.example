# Copia este archivo como .env.local (está en .gitignore) y ajusta los valores.
# Expo solo expone al código las variables que empiezan con EXPO_PUBLIC_.
# Reinicia `npx expo start` después de cambiarlas.

# URL de la web/API del backend (README §13). En un teléfono físico NO uses localhost:
# usa la IP de tu computadora en la misma red wifi. Revisa el puerto con el que arranca la web.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# true = usar datos de ejemplo locales (sin backend ni red). Cualquier otro valor usa la API.
EXPO_PUBLIC_USE_MOCK=false
